# ==========================================
# HR Plus - Environment Configuration
# ==========================================

# Server
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# Database (MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=hr_plus
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_DIALECT=mysql
DB_LOGGING=false

# JWT Authentication
JWT_SECRET=change_this_to_a_long_random_secret_key
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=change_this_to_a_different_long_random_secret
JWT_REFRESH_EXPIRES_IN=7d

# bcrypt
BCRYPT_SALT_ROUNDS=10

# CORS
CORS_ORIGIN=http://localhost:5500

# Rate Limiting
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10
GLOBAL_RATE_LIMIT_WINDOW_MS=900000
GLOBAL_RATE_LIMIT_MAX=1000

# Dashboard
DASHBOARD_POLL_INTERVAL_SECONDS=60

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100